// ─────────────────────────────────────────────────────────────
//  Grocery System — Prisma Schema (Foundation v0.1.0)
//
//  Reference: docs/03-database-design.md
//  Locked decisions: docs/12-agent-memory.md
//
//  Foundation models (8): Store, User, Role, Permission,
//                         RolePermission, UserRole, Setting, AuditLog
//
//  Conventions:
//  • IDs: cuid()
//  • Money: Decimal @db.Decimal(14, 2)
//  • Timestamps: createdAt / updatedAt (snake_case @map)
//  • Soft-delete: deletedAt (where applicable)
//  • Multi-store ready via storeId (single store enforced in v1)
//  • Foundation: validate / format / generate only — NO migrations
//    (Phase 2 will run `prisma migrate dev`)
//
//  Archived 27-model schema: docs/legacy/foundation-schema-archive.prisma
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  CORE — Store & Settings
// ═══════════════════════════════════════════════════════════════

/// Single store record (v1). Multi-store deferred to v2.
model Store {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("YER")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  roles         Role[]
  settings      Setting[]
  auditLogs     AuditLog[]
  customers     Customer[]
  notifications Notification[]
  suppliers     Supplier[]
  purchases     Purchase[]

  // Phase 5 relations
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  dailyIncome       DailyIncome[]

  // Phase 6 relations
  sales Sale[]

  @@map("stores")
}

/// Generic key-value settings table per store.
/// Replaces ad-hoc fields previously embedded in Store
/// (e.g., default_sale_mode, large_transaction_threshold).
/// Values are stored as JSON for flexibility.
model Setting {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId])
  @@map("settings")
}

// ═══════════════════════════════════════════════════════════════
//  IDENTITY & RBAC
// ═══════════════════════════════════════════════════════════════

/// Application user (worker/owner). Authenticated by username + password.
model User {
  id                  String    @id @default(cuid())
  storeId             String    @map("store_id")
  username            String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  phone               String?
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  // Phase 2 — Account lockout / brute-force defense
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  // Phase 3 relations
  customersCreated      Customer[]            @relation("CustomerCreatedBy")
  transactionsCreated   CustomerTransaction[] @relation("TxCreatedBy")
  transactionsCancelled CustomerTransaction[] @relation("TxCancelledBy")
  notifications         Notification[]

  // Phase 4 relations
  suppliersCreated    Supplier[]            @relation("SupplierCreatedBy")
  supplierTxCreated   SupplierTransaction[] @relation("SupplierTxCreatedBy")
  supplierTxCancelled SupplierTransaction[] @relation("SupplierTxCancelledBy")
  purchasesCreated    Purchase[]            @relation("PurchaseCreatedBy")
  purchasesCancelled  Purchase[]            @relation("PurchaseCancelledBy")

  // Phase 5 relations
  expenseCategoriesCreated ExpenseCategory[] @relation("ExpenseCategoryCreatedBy")
  expensesCreated          Expense[]         @relation("ExpenseCreatedBy")
  expensesCancelled        Expense[]         @relation("ExpenseCancelledBy")
  dailyIncomeClosed        DailyIncome[]     @relation("DailyIncomeClosedBy")

  // Phase 6 relations
  salesCreated   Sale[] @relation("SaleCreatedBy")
  salesCancelled Sale[] @relation("SaleCancelledBy")

  @@index([storeId])
  @@index([isActive])
  @@map("users")
}

/// Named role (e.g., owner, manager, sales_worker, accountant, inventory_officer).
model Role {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([storeId, key])
  @@index([storeId])
  @@map("roles")
}

/// Static permission catalog (seeded). Code format: "<module>.<action>".
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Junction: which permissions a role grants.
/// constraintsJson is reserved (B4) — unused in v1.
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String   @map("role_id")
  permissionId    String   @map("permission_id")
  constraintsJson Json?    @map("constraints_json")
  createdAt       DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Junction: which roles a user holds.
model UserRole {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ═══════════════════════════════════════════════════════════════
//  AUTH — Refresh tokens & idempotency (Phase 2)
// ═══════════════════════════════════════════════════════════════

/// Hashed refresh tokens (SHA-256). One row per active session.
/// Rotation: each /auth/refresh issues a new row and revokes the old one.
/// Cleanup: expired rows are pruned on login.
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  rememberMe  Boolean   @default(false) @map("remember_me")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

/// Idempotency cache for mutating endpoints. TTL = 24h.
/// The frontend sends `Idempotency-Key: <uuid>` on POST/PUT/PATCH/DELETE.
/// If the key was seen before, the cached response is returned.
model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  userId     String?  @map("user_id")
  endpoint   String
  statusCode Int      @map("status_code")
  response   Json
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ═══════════════════════════════════════════════════════════════
//  AUDIT
// ═══════════════════════════════════════════════════════════════

/// Append-only audit trail. Required by golden rule #3.
model AuditLog {
  id         String      @id @default(cuid())
  storeId    String      @map("store_id")
  actorId    String?     @map("actor_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
//  CUSTOMERS — Phase 3 (P3-1)
// ═══════════════════════════════════════════════════════════════

/// A retail customer who can carry a debt balance.
/// `currentBalance` is the source of truth (denormalised from transactions
/// for fast reads). All mutations go through `prisma.$transaction` with
/// row locking to keep it consistent with the immutable transaction log.
model Customer {
  id            String  @id @default(cuid())
  storeId       String  @map("store_id")
  name          String
  phone         String?
  address       String?
  whatsappPhone String? @map("whatsapp_phone")

  // Financial — Decimal(14,2) per docs/03 currency rules.
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(14, 2)
  creditLimit    Decimal? @map("credit_limit") @db.Decimal(14, 2)

  // Lifecycle / status
  status     CustomerStatus @default(ACTIVE)
  graceUntil DateTime?      @map("grace_until")

  // Metadata
  notes       String?
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  store            Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy        User                      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions     CustomerTransaction[]
  reminderSettings CustomerReminderSettings?

  // Phase 6 relations
  sales Sale[]

  @@index([storeId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  FROZEN
  GRACE_PERIOD
}

/// Append-only ledger of customer balance movements.
/// `balanceBefore` / `balanceAfter` are snapshots of `Customer.currentBalance`
/// taken inside the same DB transaction that mutates the parent row, so the
/// timeline is fully reconstructible even if `Customer.currentBalance` is
/// out of sync (it never should be).
model CustomerTransaction {
  id            String                  @id @default(cuid())
  customerId    String                  @map("customer_id")
  type          CustomerTransactionType
  amount        Decimal                 @db.Decimal(14, 2)
  balanceBefore Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal                 @map("balance_after") @db.Decimal(14, 2)
  notes         String?

  // Cancellation (soft — original row preserved for audit)
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  // Optional reference to a future Sale (Phase 6)
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TxCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?    @relation("TxCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@index([cancelledAt])
  @@map("customer_transactions")
}

enum CustomerTransactionType {
  DEBT
  PAYMENT
  ADJUSTMENT
  OPENING
}

/// Per-customer reminder configuration (WhatsApp). Templates are looked up
/// by `templateId` once a template registry is added (deferred to P4+).
model CustomerReminderSettings {
  id         String    @id @default(cuid())
  customerId String    @unique @map("customer_id")
  enabled    Boolean   @default(false)
  frequency  String    @default("monthly") // "weekly" | "monthly"
  lastSentAt DateTime? @map("last_sent_at")
  templateId String?   @map("template_id")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_reminder_settings")
}

// ═══════════════════════════════════════════════════════════════
//  NOTIFICATIONS — Phase 3 (P3-1)
// ═══════════════════════════════════════════════════════════════

/// In-app notification. `userId = null` means broadcast (all managers / owners).
/// `metadata` carries arbitrary structured context (e.g., customer / amount).
model Notification {
  id       String           @id @default(cuid())
  userId   String?          @map("user_id")
  storeId  String           @map("store_id")
  type     NotificationType
  title    String
  body     String
  metadata Json?

  readAt DateTime? @map("read_at")
  sentAt DateTime  @default(now()) @map("sent_at")

  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([storeId])
  @@index([type])
  @@index([sentAt])
  @@map("notifications")
}

enum NotificationType {
  CREDIT_LIMIT_EXCEEDED
  GRACE_PERIOD_ENDING
  CUSTOMER_INACTIVE
  CUSTOMER_DEBT_HIGH
  // Additional types are added in later phases.
}

// ═══════════════════════════════════════════════════════════════
//  SUPPLIERS — Phase 4 (P4-1)
// ═══════════════════════════════════════════════════════════════

/// A vendor that supplies goods to the store. Mirrors `Customer`
/// but with inverted balance semantics:
///   currentBalance > 0  → store OWES the supplier (unpaid credit purchases)
///   currentBalance = 0  → settled
///   currentBalance < 0  → store has overpaid / supplier owes us (credit)
///
/// All financial mutations go through `prisma.$transaction` with
/// row-locking (`SELECT ... FOR UPDATE` semantics) to keep
/// `currentBalance` consistent with the immutable transaction log.
model Supplier {
  id            String  @id @default(cuid())
  storeId       String  @map("store_id")
  name          String
  phone         String?
  whatsappPhone String? @map("whatsapp_phone")
  address       String?

  // Financial — Decimal(14,2) per docs/03 currency rules.
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(14, 2)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(14, 2)

  // Lifecycle
  isActive Boolean @default(true) @map("is_active")

  // Metadata
  notes       String?
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions SupplierTransaction[]
  purchases    Purchase[]

  @@index([storeId])
  @@index([isActive])
  @@index([phone])
  @@index([deletedAt])
  @@map("suppliers")
}

/// Append-only ledger of supplier balance movements.
/// `balanceBefore` / `balanceAfter` are snapshots of `Supplier.currentBalance`
/// captured inside the same DB transaction that mutates the supplier row.
///
/// Type semantics:
/// - OPENING: initial balance set at creation (one row per supplier max).
/// - CREDIT_PURCHASE: created by `Purchase` with paymentType=CREDIT.
///                    Increases supplier balance (we owe more).
///                    `referenceType="purchase"`, `referenceId=Purchase.id`.
/// - PAYMENT: store pays the supplier. Decreases supplier balance.
/// - ADJUSTMENT: manual correction (positive or negative). Owner-only.
model SupplierTransaction {
  id            String                  @id @default(cuid())
  supplierId    String                  @map("supplier_id")
  type          SupplierTransactionType
  amount        Decimal                 @db.Decimal(14, 2)
  balanceBefore Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal                 @map("balance_after") @db.Decimal(14, 2)
  notes         String?

  // Cancellation (soft — original row preserved for audit)
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  // Reference to a Purchase row (for CREDIT_PURCHASE) or future entities.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("SupplierTxCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?    @relation("SupplierTxCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([type])
  @@index([createdAt])
  @@index([cancelledAt])
  @@index([referenceType, referenceId])
  @@map("supplier_transactions")
}

enum SupplierTransactionType {
  OPENING
  CREDIT_PURCHASE
  PAYMENT
  ADJUSTMENT
}

// ═══════════════════════════════════════════════════════════════
//  PURCHASES — Phase 4 (P4-3)
// ═══════════════════════════════════════════════════════════════

/// A purchase recorded against a supplier.
///
/// Payment-type semantics (LOCKED — see docs/12-agent-memory.md):
/// - CASH: records the purchase row only. NO `SupplierTransaction` created.
///         NO change to `Supplier.currentBalance`. Cash-flow tracking is
///         handled by Phase 5 (`Expense` of type `CASH_PURCHASE_LINK` may
///         reference this row but creates no double ledger entry).
/// - CREDIT: atomic — within ONE `prisma.$transaction` we
///           (1) create this `Purchase` row,
///           (2) create a `SupplierTransaction(CREDIT_PURCHASE)` row,
///           (3) increase `Supplier.currentBalance` by `totalAmount`.
///           Cancellation reverses (2) + (3) atomically.
///
/// `hasItems` is denormalised so list pages can show a "detailed" badge
/// without a join. Item-level data lives in `PurchaseItem`. For Phase 4
/// items are free-text (no Product link); Phase 9 will populate `productId`.
model Purchase {
  id          String              @id @default(cuid())
  storeId     String              @map("store_id")
  supplierId  String              @map("supplier_id")
  paymentType PurchasePaymentType @map("payment_type")
  totalAmount Decimal             @map("total_amount") @db.Decimal(14, 2)
  notes       String?
  hasItems    Boolean             @default(false) @map("has_items")

  // Cancellation
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?          @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       PurchaseItem[]

  @@index([storeId])
  @@index([supplierId])
  @@index([paymentType])
  @@index([createdAt])
  @@index([cancelledAt])
  @@map("purchases")
}

enum PurchasePaymentType {
  CASH
  CREDIT
}

/// Line item for a detailed `Purchase`.
/// `productId` is reserved for Phase 9 (Inventory) — kept null until then.
/// `name` is free-text so the system stays usable without inventory enabled.
model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String  @map("purchase_id")
  productId  String? @map("product_id") // Phase 9 — Inventory
  name       String
  quantity   Decimal @db.Decimal(14, 2)
  unitCost   Decimal @map("unit_cost") @db.Decimal(14, 2)
  totalCost  Decimal @map("total_cost") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ═══════════════════════════════════════════════════════════════
//  EXPENSES & DAILY INCOME — Phase 5 (P5-1)
// ═══════════════════════════════════════════════════════════════

/// Category used to bucket expenses for reports.
/// Soft-deletable; cannot be hard-deleted while expenses reference it.
model ExpenseCategory {
  id          String  @id @default(cuid())
  storeId     String  @map("store_id")
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ExpenseCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("expense_categories")
}

/// Cash outflow with three semantic modes:
///   • NORMAL              → free-form expense (utilities, salaries, etc.)
///   • SUPPLIER_PAYMENT    → payment to a supplier. Atomically also creates
///                            a SupplierTransaction(PAYMENT) and decreases
///                            Supplier.currentBalance. The link is recorded
///                            via referenceType='supplier_transaction'.
///   • CASH_PURCHASE_LINK  → tags an existing cash Purchase as the source
///                            so that reports can show the expense breakdown
///                            without double-counting the cash outflow
///                            (the Purchase row is the authoritative ledger).
///                            referenceType='purchase', referenceId=Purchase.id.
///
/// Critical no-double-count rule (LOCKED in docs/12-agent-memory.md):
///   When type=CASH_PURCHASE_LINK, daily-income summaries MUST skip the
///   Expense row and read from purchases instead.
model Expense {
  id          String      @id @default(cuid())
  storeId     String      @map("store_id")
  categoryId  String      @map("category_id")
  type        ExpenseType
  amount      Decimal     @db.Decimal(14, 2)
  description String
  expenseDate DateTime    @default(now()) @map("expense_date") @db.Date

  // Optional reference (set when type ≠ NORMAL).
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  // Cancellation (soft) — preserves audit trail.
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([storeId, expenseDate])
  @@index([categoryId])
  @@index([type])
  @@index([cancelledAt])
  @@index([referenceType, referenceId])
  @@map("expenses")
}

enum ExpenseType {
  NORMAL
  SUPPLIER_PAYMENT
  CASH_PURCHASE_LINK
}

/// Per-day aggregate. ONE row per (storeId, date).
///
/// Aggregates are recomputed atomically on every relevant write (sale,
/// expense, cash-purchase-link, supplier payment via SUPPLIER_PAYMENT
/// expense). Once `closedAt` is set the row is immutable.
///
/// All amounts are derived (so a re-run gives the same values), but stored
/// for fast list/print without re-aggregating historical days.
model DailyIncome {
  id               String    @id @default(cuid())
  storeId          String    @map("store_id")
  date             DateTime  @db.Date
  openingCash      Decimal   @default(0) @map("opening_cash") @db.Decimal(14, 2)
  cashSales        Decimal   @default(0) @map("cash_sales") @db.Decimal(14, 2)
  creditSales      Decimal   @default(0) @map("credit_sales") @db.Decimal(14, 2)
  customerPayments Decimal   @default(0) @map("customer_payments") @db.Decimal(14, 2)
  cashPurchases    Decimal   @default(0) @map("cash_purchases") @db.Decimal(14, 2)
  supplierPayments Decimal   @default(0) @map("supplier_payments") @db.Decimal(14, 2)
  normalExpenses   Decimal   @default(0) @map("normal_expenses") @db.Decimal(14, 2)
  /// closing = openingCash + cashSales + customerPayments
  ///         − cashPurchases − supplierPayments − normalExpenses
  closingCash      Decimal   @default(0) @map("closing_cash") @db.Decimal(14, 2)
  notes            String?
  closedAt         DateTime? @map("closed_at")
  closedById       String?   @map("closed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  closedBy User? @relation("DailyIncomeClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([storeId, date])
  @@index([storeId, date])
  @@index([closedAt])
  @@map("daily_income")
}

// ═══════════════════════════════════════════════════════════════
//  SALES — Phase 6 (P6-1)
// ═══════════════════════════════════════════════════════════════

/// Sale to a customer. Three modes (LOCKED in docs/12-agent-memory.md):
///   • QUICK       → cash, no line items, just a total. Hits DailyIncome.
///   • DETAILED    → cash, optional line items. Same financial effect as QUICK.
///   • CREDIT      → customer required + credit-limit check + atomically
///                    creates CustomerTransaction(DEBT) and increases the
///                    customer's currentBalance.
///
/// Cancellation reverses all financial side effects atomically.
model Sale {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  mode        SaleMode
  customerId  String?  @map("customer_id") // required for CREDIT
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  notes       String?
  hasItems    Boolean  @default(false) @map("has_items")

  // Soft-cancel
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy   User       @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       SaleItem[]

  @@index([storeId])
  @@index([customerId])
  @@index([mode])
  @@index([createdAt])
  @@index([cancelledAt])
  @@map("sales")
}

enum SaleMode {
  QUICK
  DETAILED
  CREDIT
}

/// Line item for a DETAILED or CREDIT sale (optional for both).
/// `productId` is reserved for Phase 9 (Inventory).
model SaleItem {
  id         String  @id @default(cuid())
  saleId     String  @map("sale_id")
  productId  String? @map("product_id")
  name       String
  quantity   Decimal @db.Decimal(14, 2)
  unitPrice  Decimal @map("unit_price") @db.Decimal(14, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

